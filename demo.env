# ==============================================================================
# MOGGIE ATTIRES - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/moggie?retryWrites=true&w=majority

# Client Application URLs (CORS & Redirection)
CLIENT_URL=https://moggieattires.com
ADMIN_PANEL_URL=https://admin.moggieattires.com

# Cookie & Domain Configuration
COOKIE_DOMAIN=.moggieattires.com

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ImageKit (Cloud Media Storage & Optimization)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Shipping Settings (Default rules until Shiprocket is connected)
DEFAULT_SHIPPING_FEE=0
FREE_SHIPPING_THRESHOLD=999

# Email Notification Settings (Nodemailer via Gmail)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_specific_password
ADMIN_EMAIL=admin@moggieattires.com
SUPPORT_EMAIL=support@moggieattires.com
